# Firebase Web Config
# Firebase Console -> Project settings -> Your apps -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Multi-branch Configuration (Tùy chọn)
# Để trống đối với chi nhánh chính.
# Đối với chi nhánh 2: VITE_BRANCH_PREFIX=cn2_
VITE_BRANCH_PREFIX=
# Tên hiển thị chi nhánh (ví dụ: "Chi Nhánh Huyện B")
VITE_BRANCH_NAME=
# Email Admin riêng của chi nhánh (nếu không set sẽ mặc định admin_cn2@lottee.internal)
VITE_ADMIN_EMAIL=
